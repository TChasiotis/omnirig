<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.omnirig.controllers.EmployeeDashboardController">
   <children>
      <Label text="OmniRig - Διαχείριση Αποθήκης">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <!-- Η Μπάρα Αναζήτησης (Δυναμικά Ερωτήματα) -->
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Αναζήτηση:" />
            <TextField fx:id="searchNameField" prefWidth="200.0" promptText="π.χ. Ryzen..." />
            <Label text="Max Τιμή (€):" />
            <TextField fx:id="maxPriceField" prefWidth="100.0" promptText="π.χ. 200" />
            <Button mnemonicParsing="false" onAction="#handleSearch" text="Φιλτράρισμα" />
            <Button mnemonicParsing="false" onAction="#handleClear" text="Καθαρισμός" />
         </children>
      </HBox>
      
      <TableView fx:id="productTable" prefHeight="500.0" prefWidth="760.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colName" prefWidth="350.0" text="Όνομα Εξαρτήματος" />
          <TableColumn fx:id="colPrice" prefWidth="120.0" text="Τιμή (€)" />
          <TableColumn fx:id="colStock" prefWidth="100.0" text="Απόθεμα" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>