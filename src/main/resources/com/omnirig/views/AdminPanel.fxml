<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnirig.controllers.AdminPanelController">
   <content>
      <StackPane alignment="TOP_CENTER" style="-fx-background-color: #F8FAFC;">
         <children>
            <VBox maxWidth="1060.0" spacing="20.0">
               <padding>
                  <Insets top="24.0" right="32.0" bottom="40.0" left="32.0" />
               </padding>
               <children>

                  <!-- ADMIN HEADER -->
                  <HBox alignment="CENTER_LEFT" spacing="16.0"
                        style="-fx-background-color: #0F172A; -fx-background-radius: 14;">
                     <padding>
                        <Insets top="18.0" right="24.0" bottom="18.0" left="24.0" />
                     </padding>
                     <children>
                        <VBox spacing="3.0">
                           <children>
                              <Label text="OmniRig Management Console"
                                     style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;" />
                              <Label text="Διαχείριση Καταλόγου • Ιστορικό Ενεργειών • Αναφορές • Διαγνωστικά Συστήματος"
                                     style="-fx-font-size: 12px; -fx-text-fill: #94A3B8;" />
                           </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Επιστροφή στο Κατάστημα" onAction="#handleExitAdmin" minWidth="-Infinity"
                                style="-fx-background-color: #1E293B; -fx-text-fill: #F8FAFC; -fx-font-weight: bold; -fx-padding: 9 18; -fx-background-radius: 8; -fx-border-color: #334155; -fx-border-radius: 8; -fx-cursor: hand;" />
                     </children>
                  </HBox>

                  <!-- TABS BAR -->
                  <HBox spacing="10.0" alignment="CENTER_LEFT">
                     <children>
                        <Button fx:id="tabProductsBtn" text="Διαχείριση Προϊόντων" onAction="#showProductsTab" />
                        <Button fx:id="tabLogsBtn" text="Ιστορικό Ενεργειών" onAction="#showLogsTab" />
                        <Button fx:id="tabQueriesBtn" text="Αναφορές &amp; Στατιστικά" onAction="#showQueriesTab" />
                        <Button fx:id="tabConcurrencyBtn" text="Διαγνωστικά Συστήματος" onAction="#showConcurrencyTab" />
                     </children>
                  </HBox>

                  <!-- TAB CONTENT -->
                  <VBox fx:id="tabContentBox" spacing="16.0" />

               </children>
            </VBox>
         </children>
      </StackPane>
   </content>
</ScrollPane>