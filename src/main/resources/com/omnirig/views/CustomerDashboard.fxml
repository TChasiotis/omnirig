<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnirig.controllers.CustomerDashboardController">

   <!-- TOP NAVBAR -->
   <top>
      <HBox alignment="CENTER_LEFT" styleClass="navbar">
         <children>
            <Label styleClass="brand-title" text="OmniRig" />
            <TextField fx:id="searchNameField" onAction="#handleSearch" prefWidth="340.0"
                       promptText="Αναζήτηση εξαρτήματος (π.χ. Ryzen, RTX, NZXT)..." styleClass="search-field" />
            <Button mnemonicParsing="false" onAction="#handleSearch" styleClass="btn-primary" text="Αναζήτηση" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleOpenPcBuilder" styleClass="btn-builder" text="PC Builder" />
            <Button fx:id="cartButton" mnemonicParsing="false" styleClass="btn-outline" text="Καλάθι (0)" />
            <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="Είσοδος" />
            <Button mnemonicParsing="false" onAction="#handleRegister" styleClass="btn-outline" text="Εγγραφή" />
         </children>
      </HBox>
   </top>

   <!-- LEFT SIDEBAR: Κατηγορίες -->
   <left>
      <VBox fx:id="categoryBox" prefWidth="220.0" styleClass="sidebar">
         <children>
            <Label styleClass="sidebar-title" text="ΚΑΤΗΓΟΡΙΕΣ" />
         </children>
      </VBox>
   </left>

   <!-- CENTER: Product Grid -->
   <center>
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8FAFC;">
         <content>
            <VBox spacing="16.0">
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
               <children>
                  <Label fx:id="sectionTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"
                         text="Όλα τα Προϊόντα" />
                  <FlowPane fx:id="productGrid" hgap="18.0" vgap="18.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>