<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="mainPane" prefHeight="750.0" prefWidth="1200.0" stylesheets="@../css/styles.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnirig.controllers.CustomerDashboardController">

   <!-- TOP NAVBAR -->
   <top>
      <HBox fx:id="topBar" alignment="CENTER_LEFT" styleClass="navbar">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8" onMouseClicked="#handleLogoClick" style="-fx-cursor: hand;">
               <ImageView fitHeight="36.0" preserveRatio="true" smooth="true">
                  <image>
                     <Image url="@../images/logo/pc.png" />
                  </image>
               </ImageView>
               <HBox alignment="CENTER_LEFT" spacing="0">
                  <Label text="Omni" styleClass="logo-omni" />
                  <Label text="Rig"  styleClass="logo-rig" />
               </HBox>
            </HBox>

            <TextField fx:id="searchNameField" onAction="#handleSearch" prefWidth="250.0"
                       promptText="Αναζήτηση εξαρτήματος (π.χ. Ryzen, RTX, NZXT)..." styleClass="search-field" />
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleSearch" styleClass="btn-primary" text="Αναζήτηση" />
            <Region HBox.hgrow="ALWAYS" />
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleOpenPcBuilder" styleClass="btn-builder" text="PC Builder" />
            <Button minWidth="-Infinity" fx:id="cartButton" mnemonicParsing="false" styleClass="btn-outline" text="Καλάθι (0)" />
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-primary" text="Είσοδος" />
            <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleRegister" styleClass="btn-outline" text="Εγγραφή" />
            <HBox spacing="4" alignment="CENTER_RIGHT" style="-fx-padding: 0 0 0 8;">
               <Button fx:id="btnMinimize" styleClass="win-btn" onAction="#handleMinimize"/>
               <Button fx:id="btnMaximize" styleClass="win-btn" onAction="#handleMaximize"/>
               <Button fx:id="btnClose"    styleClass="win-btn, win-btn-close" onAction="#handleClose"/>
            </HBox>
         </children>
      </HBox>
   </top>

   <!-- LEFT SIDEBAR: Κατηγορίες -->
   <left>
      <VBox fx:id="categoryBox" prefWidth="220.0" styleClass="sidebar">
         <children>
            <Label styleClass="sidebar-title" text="ΚΑΤΗΓΟΡΙΕΣ" />
         </children>
      </VBox>
   </left>

   <!-- CENTER: Product Grid -->
   <center>
      <ScrollPane fx:id="catalogScroll" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8FAFC;">
         <content>
            <VBox spacing="16.0">
               <padding>
                  <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
               </padding>
               <children>
                  <Label fx:id="sectionTitle" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0F172A;"
                         text="Όλα τα Προϊόντα" />
                  <FlowPane fx:id="productGrid" hgap="18.0" vgap="18.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>