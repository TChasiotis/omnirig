<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: transparent; -fx-background: #F8FAFC;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnirig.controllers.CartController">
   <content>
      <StackPane alignment="TOP_CENTER" style="-fx-background-color: #F8FAFC;">
         <children>
            <VBox maxWidth="980.0" spacing="20.0">
               <padding>
                  <Insets top="24.0" right="32.0" bottom="36.0" left="32.0" />
               </padding>
               <children>

                  <!-- HEADER -->
                  <HBox alignment="CENTER_LEFT" spacing="16.0">
                     <children>
                        <Button text="←  Συνέχεια Αγορών" onAction="#handleBack"
                                style="-fx-background-color: #FFFFFF; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-cursor: hand;" />
                        <Label text="Το Καλάθι μου"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="clearCartBtn" text="Άδειασμα Καλαθιού" onAction="#handleClearCart"
                                style="-fx-background-color: #FEE2E2; -fx-text-fill: #B91C1C; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 8; -fx-cursor: hand;" />
                     </children>
                  </HBox>

                  <!-- CONTENT: ITEMS + SUMMARY -->
                  <HBox spacing="24.0" alignment="TOP_LEFT">
                     <children>
                        <!-- Λίστα Προϊόντων -->
                        <VBox fx:id="itemsContainer" spacing="12.0" HBox.hgrow="ALWAYS" />

                        <!-- Κάρτα Σύνοψης -->
                        <VBox fx:id="summaryCard" prefWidth="310.0" minWidth="310.0" spacing="14.0"
                              style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-color: #E2E8F0; -fx-border-radius: 14;">
                           <padding>
                              <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
                           </padding>
                           <children>
                              <Label text="Σύνοψη Παραγγελίας"
                                     style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                              <Separator />
                              <HBox>
                                 <Label text="Υποσύνολο προϊόντων" style="-fx-text-fill: #64748B;" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label fx:id="subtotalLbl" text="0,00 €" style="-fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                              </HBox>
                              <HBox>
                                 <Label text="Μεταφορικά" style="-fx-text-fill: #64748B;" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label fx:id="shippingLbl" text="Δωρεάν" style="-fx-font-weight: bold; -fx-text-fill: #10B981;" />
                              </HBox>
                              <Label fx:id="freeShippingHintLbl" wrapText="true"
                                     style="-fx-text-fill: #64748B; -fx-font-size: 11px;" />
                              <Separator />
                              <HBox alignment="CENTER_LEFT">
                                 <Label text="Σύνολο" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0F172A;" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label fx:id="totalLbl" text="0,00 €" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2563EB;" />
                              </HBox>
                              <Button fx:id="checkoutBtn" text="Προς Checkout  →" maxWidth="Infinity"
                                      onAction="#handleProceedToCheckout" styleClass="btn-builder"
                                      style="-fx-padding: 12 16; -fx-font-size: 14px;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

               </children>
            </VBox>
         </children>
      </StackPane>
   </content>
</ScrollPane>